# Shape only. Real values live in Supabase secrets, n8n variables, and Lovable
# env vars — never in this repo.

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                  # safe for the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # SERVER ONLY. Bypasses RLS. n8n + edge functions.

# ---- GoHighLevel ----
GHL_PIT=pit-...                           # Private Integration Token, Attic Plus sub-account
GHL_LOCATION_ID=
GHL_CALENDAR_ID=                          # the "Installations" calendar

# ---- App ----
APP_URL=https://crew.atticplus.com.au
GEOFENCE_RADIUS_M=150                     # a flag, not a gate
PHOTO_MAX_WIDTH_PX=1280
PHOTO_JPEG_QUALITY=0.7
